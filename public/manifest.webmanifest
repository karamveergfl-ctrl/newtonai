{
  "id": "/",
  "name": "NewtonAI – AI Study Assistant",
  "short_name": "NewtonAI",
  "description": "Turn notes, PDFs and lectures into AI summaries, quizzes, flashcards, podcasts and mind maps.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#0B1020",
  "theme_color": "#0B1020",
  "lang": "en",
